unit Forma_Principal;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls;

type
  TFormaPrincipal = class(TForm)
    Panel1: TPanel;
    Panel2: TPanel;
    Panel3: TPanel;
    btnClean: TButton;
    Button2: TButton;
    Button3: TButton;
    Label1: TLabel;
    Label2: TLabel;
    Label3: TLabel;
    Edit1: TEdit;
    Edit2: TEdit;
    Edit3: TEdit;
    btnADD: TButton;
    btnSUB: TButton;
    btnMUL: TButton;
    Button7: TButton;
    procedure btnADDClick(Sender: TObject);
    procedure btnSUBClick(Sender: TObject);
    procedure btnMULClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormaPrincipal: TFormaPrincipal;

implementation

{$R *.dfm}

procedure TFormaPrincipal.btnMULClick(Sender: TObject);
var
 n1,n2,r: byte;
begin
      n1:=strToInt(Edit1.text);
      n2:=strToInt(Edit2.Text);
      asm
          mov al,n1
          mov bl,n2
          mul al,bl
          mov r,al
      end;//fin asm

      Edit3.text:=IntTostr(r);
end;

procedure TFormaPrincipal.btnADDClick(Sender: TObject);
//variables locales
var
 n1,n2,r: byte;

begin
      n1:=strToInt(Edit1.text);
      n2:=strToInt(Edit2.Text);
      asm
          mov al,n1
          mov bl,n2
          add al,bl
          mov r,al
      end;//fin asm

      Edit3.text:=IntTostr(r);
end;

procedure TFormaPrincipal.btnSUBClick(Sender: TObject);
  var n1,n2,r: byte;

begin
  n1:=strToInt(Edit1.Text);
  n2:=strToInt(Edit2.text);
  asm
      mov al,n1
      mov bl,n2
      sub al,bl
      mov r,al
  end;//fin asm

  Edit3.Text:=IntTostr(r);
end;

end.
